rules_version = '2';

// BytePrep — production Firestore rules
// Every user can read/write only their own documents.
// Admin collections require the caller's profile to have adminRights == true.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.adminRights == true;
    }

    // ---- Profiles ----
    match /profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Owner may create/update own profile, but MUST NOT self-elevate adminRights.
      allow create: if isOwner(uid)
                    && (!('adminRights' in request.resource.data)
                        || request.resource.data.adminRights == false);
      allow update: if isOwner(uid)
                    && (!('adminRights' in request.resource.data)
                        || request.resource.data.adminRights == resource.data.adminRights)
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ---- Per-user owned subcollections/collections ----
    // Documents carry a userId field. Simple, scales, single-query friendly.
    match /missions/{docId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
    }

    match /focus_sessions/{docId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
    }

    match /chapter_meta/{docId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
    }

    match /chapter_customizations/{docId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
    }

    match /tests/{docId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
    }

    match /ai_personalization/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /ai_memory/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ---- Admin-only collections ----
    match /admin_settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /allen_credentials/{uid} {
      // A user can read/write their own creds; admins can inspect for support.
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /allen_sync_state/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // Default deny — anything not matched above is inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
